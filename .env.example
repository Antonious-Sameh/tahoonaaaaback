# ── System 1 Backend — Environment Configuration ────────────────────────────
# Copy this file to `.env` for local development. Never commit the real `.env`.
# On Vercel, set these as Project Environment Variables instead of a file.

# development | test | production
NODE_ENV=development

# Port for local dev only (`npm run dev` / `npm start`). Not used on Vercel —
# serverless functions don't listen on a port.
PORT=4000

# MongoDB Atlas connection string for System 1's OWN, independent database.
# System 1 never shares a cluster/database with Systems 2-4.
# Leave empty during early development before Atlas is set up — the app still
# boots; only routes that touch the database will fail until this is set.
MONGODB_URI=

# Comma-separated list of allowed frontend origins for CORS.
# This frontend's dev server runs on port 3000 (see its package.json) — not
# Vite's default 5173. Update this if you run it on a different port.
# Example: http://localhost:3000,https://system1-shop.vercel.app
CORS_ORIGINS=http://localhost:3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Product image uploads (Cloudinary) ───────────────────────────────────────
# System 1's OWN Cloudinary account — never shared with Systems 2-4. Product
# images upload directly from the browser to Cloudinary; this backend only
# ever issues a short-lived signed token (GET /api/uploads/signature) and
# never receives the image bytes themselves. Optional: the app still boots
# and runs fully without these — only the "upload a product image" feature
# is unavailable until they're set (existing base64-embedded product images,
# if any, keep working unaffected either way).
# Get these from the Cloudinary dashboard (cloudinary.com) → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=system1/products

# ── Authentication (single shop-wide login, max 2 registered devices) ───────
# Secret used to sign/verify short-lived access tokens. Generate a long random
# value, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Required in production; the app still boots without it in development, but
# any route that issues/verifies a token will fail until it's set.
JWT_ACCESS_SECRET=

# Access token lifetime (minutes) and how many devices may be registered at once.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_DEVICES_PER_ACCOUNT=2

# bcrypt cost factor for hashing the shop password.
BCRYPT_SALT_ROUNDS=12

# The shop password itself is NOT set via an env var — after MONGODB_URI and
# JWT_ACCESS_SECRET are configured, set it once with:
#   npm run seed-password -- "your-password-here"

# ── Central read-only reporting access (future System 5) ────────────────────
# Optional. A long random secret — completely separate from JWT_ACCESS_SECRET
# above — that grants GET-only access to /api/admin/* (every entity: sales,
# purchases, products, inventory, customers, suppliers, cashbox, expenses,
# activity, audit log, settings, reports — see back/README.md's "Central
# read-only access" section). Generate the same way as JWT_ACCESS_SECRET, and
# use a DIFFERENT value per system (System 1's key must never work against
# System 2/3/4's backend). Leave empty to keep /api/admin/* fully disabled —
# every request to it returns 503 until this is set.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_READONLY_KEY=
